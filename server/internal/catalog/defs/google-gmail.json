{
  "id": "google-gmail",
  "name": "Gmail",
  "description": "Read message listings and individual messages from your Gmail inbox. Never sends or deletes mail.",
  "auth": { "provider": "google" },
  "hosts": ["gmail.googleapis.com"],
  "ops": [
    {
      "name": "list_messages",
      "description": "List recent messages in the inbox (IDs and thread IDs only).",
      "effect": "read",
      "scopes": ["https://www.googleapis.com/auth/gmail.metadata"],
      "args_schema": {
        "type": "object",
        "properties": {
          "max_results": {
            "type": "integer",
            "description": "Maximum number of messages to return."
          },
          "page_token": {
            "type": "string",
            "description": "Continuation token from a previous listing."
          }
        },
        "additionalProperties": false
      },
      "binding": {
        "method": "GET",
        "host": "gmail.googleapis.com",
        "path": "/gmail/v1/users/me/messages",
        "query": { "maxResults": "max_results", "pageToken": "page_token" }
      }
    },
    {
      "name": "get_message",
      "description": "Read one message, including its headers and body.",
      "effect": "read",
      "scopes": ["https://www.googleapis.com/auth/gmail.readonly"],
      "args_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Message ID from a listing."
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "binding": {
        "method": "GET",
        "host": "gmail.googleapis.com",
        "path": "/gmail/v1/users/me/messages/{id}"
      }
    }
  ]
}
